NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Where the deployment lives. Used in the links inside emails, so it has to be the real public
# address rather than localhost, and email stays off without it.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# Optional. Email is off unless all three of the above and below are set, and an invitation then
# says plainly that the person must be told directly.
#
# EMAIL_FROM must be an address at a domain verified in Resend. Until a domain is verified the only
# sender Resend accepts is onboarding@resend.dev, and it will deliver ONLY to the address that owns
# the Resend account — every other recipient is refused by the provider, not by us. That is fine for
# a first end-to-end test and useless for inviting a crew, so verify the domain before a pilot.
RESEND_API_KEY=
EMAIL_FROM=Mantara <no-reply@your-domain.example>

# Optional. Document storage stays hidden until an upload and a download have been confirmed
# against a real bucket.
DOCUMENTS_ENABLED=

# Optional. debug | info | warn | error. Defaults to info.
LOG_LEVEL=
